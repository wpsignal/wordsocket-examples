{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wordsocket/live-feed",
	"version": "0.1.0",
	"title": "WordSocket Live Feed",
	"category": "wordsocket",
	"description": "A live post feed powered by WPSignal realtime. New posts appear instantly without a page reload.",
	"keywords": [ "live", "feed", "realtime", "wpsignal", "wordsocket" ],
	"textdomain": "wordsocket",
	"render": "file:./render.php",
	"editorScript": "file:./src/editor.js",
	"viewScriptModule": "file:./src/live-feed.js",
	"style": "file:./src/live-feed.css",
	"supports": {
		"html": false,
		"interactivity": true
	},
	"attributes": {
		"postsPerPage": {
			"type": "integer",
			"default": 100
		},
		"columns": {
			"type": "integer",
			"default": 4
		}
	}
}
